# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=development
PORT=3000

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=root
DATABASE_NAME=chatcheckout

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-at-least-64-characters
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# =============================================================================
# RATE LIMITING (Proteção contra Brute Force)
# =============================================================================
# TTL: Tempo em segundos para resetar o contador
# LIMIT: Número máximo de requisições permitidas no período TTL
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# =============================================================================
# REDIS (Token Blacklist & Cache)
# =============================================================================
# Importante: Use a mesma senha configurada no docker-compose.yml
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_secret
REDIS_DB=0

# =============================================================================
# CLOUDFLARE R2 STORAGE (Upload de Arquivos)
# =============================================================================
# Cloudflare Account ID (encontrado no dashboard R2)
R2_ACCOUNT_ID=
# API Token Access Key (gerado no dashboard R2)
R2_ACCESS_KEY_ID=
# API Token Secret (gerado no dashboard R2)
R2_SECRET_ACCESS_KEY=
# Nome do bucket R2
R2_BUCKET_NAME=chatcheckout-uploads
# URL pública do bucket (ex: https://your-bucket.r2.dev)
R2_PUBLIC_URL=

# =============================================================================
# PYTHON CHAT API (Opcional)
# =============================================================================
# URL da API Python para chat AI
PYTHON_API_URL=http://localhost:8000
# Token Bearer para autenticação com a API Python
PYTHON_API_BEARER_TOKEN=your-python-api-bearer-token-change-this

# =============================================================================
# PRODUCT HASH (Encryption/Decryption)
# =============================================================================
# Secret key for encrypting/decrypting product hash containing productUrl and promptAI
PRODUCT_HASH_SECRET=your-secret-key-for-product-hash-encryption-change-this

# =============================================================================
# OBSERVABILITY - LOGGING (Structured Logging with Pino)
# =============================================================================
# Log level: error, warn, info, debug
LOG_LEVEL=info
# Log format: json (production) or pretty (development)
LOG_FORMAT=pretty

# =============================================================================
# OBSERVABILITY - ERROR TRACKING (Sentry/GlitchTip)
# =============================================================================
# Enable/disable error tracking (true/false)
ERROR_TRACKING_ENABLED=false
# Sentry DSN or GlitchTip DSN (get from your Sentry/GlitchTip dashboard)
GLITCHTIP_DSN=
# Alternative: Use SENTRY_DSN if using Sentry directly
SENTRY_DSN=
# Environment name for error tracking (development, staging, production)
SENTRY_ENVIRONMENT=development
# Sample rate for performance traces (0.0 to 1.0, where 0.1 = 10%)
TRACES_SAMPLE_RATE=0.1

# =============================================================================
# OBSERVABILITY - DISTRIBUTED TRACING (Correlation IDs)
# =============================================================================
# Header name for correlation ID (default: x-correlation-id)
CORRELATION_ID_HEADER=x-correlation-id
# Header name for request ID (default: x-request-id)
REQUEST_ID_HEADER=x-request-id

# =============================================================================
# RAILWAY DEPLOYMENT (Optional - set automatically on Railway)
# =============================================================================
# Railway deployment ID (set automatically)
RAILWAY_DEPLOYMENT_ID=
# Release version (optional, for linking errors to deployments)
RELEASE_VERSION=
